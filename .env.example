# Secure Supabase Connection URI (Get this from Supabase Database Settings)
SUPABASE_DB_CONNECTION_STRING="postgres://postgres.yourprojectid:YourSecureSecretPasswordHere@aws-0-eu-west-1.pooler.supabase.com:6543/postgres"

# Operational Variables
SYSTEM_ENVIRONMENT="production"
LOG_LEVEL="INFO"

# Cryptographic Webhook Signing Token (Must match your payment gateway webhook secret)
PAYMENT_GATEWAY_WEBHOOK_SECRET="whsec_LocalVerificationTokenSecret2026"
